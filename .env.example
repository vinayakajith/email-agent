OPENAI_API_KEY=sk-...
VOYAGE_API_KEY=pa-...
# OpenAI GPT-6-class models only (gpt-6-luna, gpt-6-sol, gpt-6.1-sol, ...).
OPENAI_MODEL=gpt-6-luna
OPENAI_ENRICH_MODEL=gpt-6-luna
DATABASE_URL=postgresql://email_agent:email_agent@localhost:5434/email_agent
# Optional fallback if the macOS Keychain is unavailable
# GMAIL_ADDRESS=you@gmail.com
# GMAIL_APP_PASSWORD=abcdabcdabcdabcd
OPENAI_ENRICH_REASONING_EFFORT=low
